  "findings": [
    {
      "kind": "corrected_error",
      "finding": "Missing pre-account volume context was a real implementation error. The equal baseline changed materially; momentum did not. Old outcomes cannot be used as current outcomes."
    },
    {
      "kind": "scope_mismatch",
      "finding": "Fixed ten-stock ARK cohort, top-three positive ranks and long cash are adaptations, not the original broad-market size-by-momentum value-weighted long-short factor. No matching original-paper reproduction has been demonstrated."
    },
    {
      "kind": "uncalibrated_assumptions",
      "finding": "Three exchange-session sale-cash lock is a conservative model, not the US statutory T+2/T+1 schedule. Broker cash usability and its return effect remain unverified. A 5% account-NAV no-trade band is 18.75% of a 26.67% slot or 62.5% of an 8% equal slot before integer rounding; these are rules, not separately measured loss attribution."
    },
    {
      "kind": "not_identified_as_causes_in_existing_paths",
      "finding": "All eight corrected paths have zero volume-cap restrictions, dividend entries and halted sessions. These observations rule out actual activation of these features in these paths, not all possible interactions or all evaluator defects."
    },
    {
      "kind": "risk_design_scope",
      "finding": "The 15% threshold rejects raw stock paths; their policy identifiers do not enter continuous.py's finite_state halt branch. It is not an implemented 15% loss guarantee. A halt/stop would still not guarantee a drawdown bound."
    },
    {
      "kind": "limited_positive_control",
      "finding": "Existing corrected equal and momentum paths show net gains, so this evaluator does detect positive accounts. This is not a matched public-strategy calibration or source/execution certification."
    }
